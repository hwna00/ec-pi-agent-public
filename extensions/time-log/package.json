{
  "name": "pi-time-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "tsconfig.json",
    "tests"
  ],
  "scripts": {
    "test": "node --import ./tests/no-network.ts --test tests/*.test.ts tests/*/*.test.ts",
    "check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "puppeteer-core": "25.11.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
