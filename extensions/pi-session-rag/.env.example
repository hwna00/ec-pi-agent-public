# 이 파일의 항목을 Pi를 실행하는 프로젝트 루트의 .env 또는 .pi/.env에 넣으세요.
# Cloudflare Account ID는 32자리 16진수이고 API Token에는 Workers AI 권한이 필요합니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 두 값을 함께 설정하면 /rag-summary의 마지막 단계에서 MongoDB에 업로드합니다.
MONGODB_URI=
MONGODB_DB=
# 선택: 폴더 이동·이름 변경에도 유지할 프로젝트 ID. 생략하면 프로젝트 폴더 이름입니다.
MONGODB_PROJECT_ID=
