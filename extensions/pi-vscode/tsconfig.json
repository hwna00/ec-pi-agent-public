{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["index.ts", "pi/**/*.ts", "shared/**/*.ts", "vscode/src/**/*.ts", "vscode/test/**/*.ts", "tests/**/*.ts"]
}
