	"layer_contract": {
		"domain": "Ecount ERP business flow: business area, business id, menu type, slip, slip relation, transaction type, progress_status, refer_alias, P attribute value owner, and user-visible failure symptom.",
		"semantic": "5.6 query-model/framework concepts that materialize the ERP flow: ModelDefinition, model id, SearchModelDefinition, ComposableModel, resolver, relation_info, Relation, Repository, material, prop, attribute, mapper, program, P and failure cause.",
		"code": "Actual repository implementation nodes: files, classes, functions, and callsites with owner_scope.",
		"evidence": "Source-backed evidence from sessions, board/clipper, docs, runtime/debug notes, and codebase manifests."
	},
	"naming_policy": {
		"primary_rule": "Choose layer node names from current codebase terminology first.",
		"lookup_sources": ["repo source", "graphify-out", "P assets", "model definitions", "item_meaning/refer_type assets"],
		"label_rule": "Keep code-searchable identifiers visible in node ids or labels, and use Korean business terms as aliases when useful.",
		"example": "Use SlipRelation with labels to_slip_relation / 불러온전표 and slip_relation / 생성한전표 instead of a purely conceptual name such as SlipRelationRole.",
		"fallback_rule": "If no codebase term exists, mark the name as provisional instead of treating it as confirmed terminology."
	},
