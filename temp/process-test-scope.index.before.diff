+import {
+	EN_MENU_TYPE,
+	EN_META_MENU_TYPE,
+	EN_META_TEMPLATE_TYPE,
+	EN_OBJECT_TYPE,
+	EN_TEMPLATE_SUB_TYPE,
+	IAttribute,
+} from '@infra/common@';
+import { TemplateUtilFeature } from './TemplateUtilFeature';
+
+/**
+ * 입출금계좌 처리용 V3 양식 항목 → ScrapingMasterModel prop 매핑.
+ * 실제 COL_CD 기준이며, 응답 alias나 컨트롤 ID를 매핑 키로 사용하지 않는다.
+ * 이 매핑은 원본 prop 참조만 제공한다. 검색 조건·표시값 변환과 외부 연결정보 병합은 별도 TODO다.
+ * 원장: scraping.bank/docs/v3-template-mapping-ledger.md (검색 6개 / 출력 48개).
+ * 재고 업무용 기본 매핑, Process → 편집 Input 매핑 및 저장 처리는 사용하지 않는다.
+ */
+export class ScrapingBankUtilFeature extends TemplateUtilFeature {
+	public getPropsMapByTransform(input_menu_type: EN_OBJECT_TYPE, data_model_id?: string): Map<string, string> {
+		// TODO: 불러오기 필드와 대상 모델 계약 확정 후 구현.
+		return new Map<string, string>();
+	}
+
+	public getPropsMapByBizzId(
+		menu_type: EN_MENU_TYPE | EN_META_MENU_TYPE | EN_META_TEMPLATE_TYPE,
+		sub_item_tf: boolean,
+		data_model_id?: string
+	): Map<string, string> {
+		switch (menu_type) {
+			case EN_META_MENU_TYPE.Process: {
+				const result = new Map<string, string>([
+					['BNK.BKDATE', 'scraping_s$data_dt'],
+					// TODO: 원본 INCREASE/DECREASE → OUT/IN 및 표시 라벨 변환.
+					['BNK.INOUT_TYPE', 'scraping_s$increase_decrease_type'],
+					['BNK.BKJUKYO', 'scraping_s$txt_014'],
+					// TODO: 수집 통화 SID와 3.0 통화 코드 값 형태 확인.
+					['REC_CUR_CD', 'scraping_s$cd_sid_001'],
+					['BNK.FRC_AMT', 'scraping_s$scraping_foreign_currency_amt'],
+					// 통합 원화 금액. 입금 전용 원시 BKINPUT과 구분한다.
+					['BNK.BKINPUT', 'scraping_s$scraping_amt'],
+					['BNK.BKJANGO', 'scraping_s$num_011'],
+					['BNK.FRC_BALNCE_AMT', 'scraping_s$num_012'],
+					// TODO: 3.0 TEXT/TEXT 일시 표시로 변환. 저장 모델은 datetime_timezone.
+					['BNK.BKXFERDATETIME', 'scraping_s$scraping_dtm'],
+					['BNK.BNK_DTLS_CTT1', 'scraping_s$txt_021'],
+					['BNK.BNK_DTLS_CTT2', 'scraping_s$txt_022'],
+					// TODO: UPDATE_DTM이 없으면 WRITE_DTM으로 fallback 후 표시 가공.
+					['BNK.MOD_DTM', 'scraping_s$update_dtm'],
+				]);
+
+				for (let index = 1; index <= 8; index++) {
+					result.set(`BNK.TXT${String(index).padStart(2, '0')}`, `scraping_s$txt_${String(index).padStart(3, '0')}`);
+				}
+				for (let index = 1; index <= 10; index++) {
+					result.set(`BNK.NUM${String(index).padStart(2, '0')}`, `scraping_s$num_${String(index).padStart(3, '0')}`);
+				}
+
+				// TODO: 표시 계좌번호/계좌명, 매핑 거래처, 연결통장, 환종정보는 별도 조회/편집 prop 확정 후 추가.
+				// TODO: BNK.TRX_DATE_NO는 전표일자/번호 조합, BNK.MODR_ID는 사용자 코드/SID 및 작성자 fallback 필요.
+				return result;
+			}
+			case EN_META_TEMPLATE_TYPE.ProcessSearch:
+				// 검색 대상 원본 prop 연결이다. 범위/계산/선택값의 검색 조건 구조를 구현한 것은 아니다.
+				// TODO: BKINPUT은 통화별 원화/외화 검색이므로 하나의 저장 prop로 고정하지 않는다.
+				// TODO: BASE_DATE_CHK는 정렬 옵션용 검색 prop 확정 후 추가한다.
+				// TODO: GUBUN(0/1/2) → 원본 입출금 코드 조건 변환, 계좌 선택값 → 암호화 식별값 변환.
+				return new Map<string, string>([
+					['BASE_DATE', 'scraping_s$scraping_dtm'],
+					['BKACCTNO', 'scraping_s$target_data_sid'],
+					['BKJUKYO', 'scraping_s$txt_014'],
+					['GUBUN', 'scraping_s$increase_decrease_type'],
+				]);
+			default:
+				return new Map<string, string>();
+		}
+	}
+
+	public getTemplateSetupAttributes(
+		menu_type: EN_MENU_TYPE | EN_META_MENU_TYPE | EN_META_TEMPLATE_TYPE,
+		props: $PropDefinition[],
+		template_sub_type: EN_TEMPLATE_SUB_TYPE
+	): IAttribute[] {
+		// TODO: 검색 범위/계산 구조, 입출금 라디오 값, 날짜·금액·수정일시의 표시/fallback 속성 구성.
+		// TODO: 거래처 편집 컨트롤과 코드 선택 후 이름 동기화는 별도 편집 Input prop 확정 후 구성.
+		// 원장의 타입/컨트롤을 기록했지만 리소스·숫자 플래그·회사별 양식 설정은 추정하지 않는다.
+		return [];
+	}
+
+	public getQuickSearchMapByBizzType(
+		menu_type: EN_MENU_TYPE | EN_META_MENU_TYPE | EN_META_TEMPLATE_TYPE
+	): Map<string, string[]> {
+		// TODO: fast_srch 플래그 및 CONVERT_COL_NM 확인 후 구현.
+		// PARAM은 요청 키이지 이번에 확정된 AN720 6개 COL_CD 중 하나가 아니다.
+		return new Map<string, string[]>();
+	}
+
+	public getPropDisplayName(
+		menu_type: EN_MENU_TYPE | EN_OBJECT_TYPE | EN_META_MENU_TYPE | EN_META_TEMPLATE_TYPE,
+		template_sub_type: EN_TEMPLATE_SUB_TYPE
+	): Map<string, string> {
+		// TODO: RESX_CD/RESX_SUB_CD 및 실제 번역값 확보 후 기존 표시명 연결.
+		// 조사표의 한글 의미 설명을 실제 양식 제목으로 대입하지 않는다.
+		return new Map<string, string>();
+	}
+}
