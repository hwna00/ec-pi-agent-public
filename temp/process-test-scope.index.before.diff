+import { IExecutionContext } from '@infra/common';
+import { EN_MENU_TYPE, EN_META_MENU_TYPE, EN_META_TEMPLATE_TYPE, feature_impl } from '@infra/common@';
+import { EN_FEATURE_ID, IGetV3MenuInfoResultDto, IV3MenuInfoFeature } from 'common.abstraction';
+
+/**
+ * 입출금계좌조회 및 처리(EBS003M)의 V3 메뉴 정보.
+ * 신규 Process 화면에서도 기존 조회(AR720)·검색(AN720) 양식을 참조한다.
+ * 편집용 Input 업무와 menu_seq, 간편검색 날짜 항목은 계약 확정 후 별도로 구성한다.
+ */
+@feature_impl(EN_FEATURE_ID.IGetScrapingBankV3MenuInfoFeature)
+export class GetScrapingBankV3MenuInfoFeature implements IV3MenuInfoFeature {
+	feature_id: string = EN_FEATURE_ID.IGetScrapingBankV3MenuInfoFeature;
+	context: IExecutionContext;
+
+	constructor(execution_context: IExecutionContext) {
+		this.context = execution_context;
+	}
+
+	getMenuInfo(menu_types: (EN_MENU_TYPE | EN_META_MENU_TYPE | EN_META_TEMPLATE_TYPE)[]): IGetV3MenuInfoResultDto {
+		const result: IGetV3MenuInfoResultDto = {};
+
+		for (const menu_type of menu_types) {
+			switch (menu_type) {
+				// 기존 List 호출과 신규 Process 호출은 각각 요청한 키로 반환한다.
+				case EN_META_MENU_TYPE.Process:
+					result[menu_type] = {
+						prg_id: 'E010205',
+						form_type: 'AR720',
+						url: '/ECERP/SVC/EBS/EBS003M',
+					};
+					break;
+				case EN_META_TEMPLATE_TYPE.ProcessSearch:
+					result[menu_type] = {
+						prg_id: 'E010205',
+						form_type: 'AN720',
+					};
+					break;
+				default:
+					// 미정인 Input 등에는 다른 업무의 메뉴 정보를 대입하지 않는다.
+					break;
+			}
+		}
+
+		return result;
+	}
+}
