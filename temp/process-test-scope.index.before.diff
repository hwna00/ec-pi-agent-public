+import { BaseProgram, IExecutionContext, program_impl, ProgramBuilder } from '@infra/common';
+import { IBaseProgramContextData, IBizzDefinition, IProgramContextDeclare } from '@infra/common@';
+import { EN_DATA_ID as EN_BIZZ_DATA_ID } from 'bizz@.abstraction';
+import { EN_DEFINITION_PURPOSE, IDefinitionPurposeContextData, IListModelDefinitionKey } from 'common.abstraction';
+import { fetchAssembledDefinition } from '../entity_resolver/assembled_definitions_resolver';
+
+interface ICustomizeProcessModelDefinitionInput extends IListModelDefinitionKey {
+	model_id: string;
+}
+
+/** 처리 메뉴의 조립 정의를 양식/active 후처리 없이 별도 인스턴스로 반환한다. */
+export function GetCustomizedProcessModelDefinition(
+	identifier: string,
+	context: IExecutionContext,
+	key: IListModelDefinitionKey
+): $ModelDefinition<any> {
+	return ProgramBuilder.create<ICustomizeProcessModelDefinitionInput, $ModelDefinition<any>>(
+		'CustomizedProcessModelProgram',
+		context
+	).execute({
+		model_id: identifier,
+		bizz_sid: key.bizz_sid,
+		template_set_sid: key.template_set_sid,
+		is_full_definition: key.is_full_definition,
+	});
+}
+
+@program_impl('CustomizedProcessModelProgram')
+export class CustomizedProcessModelProgram extends BaseProgram<
+	ICustomizeProcessModelDefinitionInput,
+	$ModelDefinition<any>
+> {
+	protected declareProgramContext(
+		dto: ICustomizeProcessModelDefinitionInput
+	): IProgramContextDeclare<IDefinitionPurposeContextData> {
+		const parent_data = this.execution_context.getProgramContext<IBaseProgramContextData>().data;
+		const ctx_bizz_definition = this.execution_context.data.fetch<IBizzDefinition>(
+			EN_BIZZ_DATA_ID.ctx_bizz_definition,
+			{ bizz_sid: dto.bizz_sid }
+		);
+		return {
+			data_type: 'CustomizedProcessModelProgram',
+			data: {
+				...parent_data,
+				tenant_sid: this.execution_context.session.tenant_sid,
+				bizz_id: ctx_bizz_definition?.bizz_id,
+				bizz_type: ctx_bizz_definition?.type,
+				bizz_sid: dto.bizz_sid,
+				template_set_sid: dto.template_set_sid,
+				definition_purpose: _.vIsTrue(dto.is_full_definition)
+					? EN_DEFINITION_PURPOSE.Setup
+					: EN_DEFINITION_PURPOSE.Runtime,
+			},
+		};
+	}
+
+	onExecute(dto: ICustomizeProcessModelDefinitionInput): $ModelDefinition<any> {
+		const program_data = this.execution_context.getProgramContext<IDefinitionPurposeContextData>().data;
+		const assembled = fetchAssembledDefinition(this.execution_context, {
+			tenant_sid: _.vSafe(program_data.tenant_sid),
+			bizz_sid: _.vSafe(program_data.bizz_sid),
+			menu_type: program_data.menu_type,
+			model_id: dto.model_id,
+			template_set_sid: program_data.template_set_sid,
+			// Runtime은 기존 조립 캐시와 같은 키를 사용한다.
+			...(program_data.definition_purpose === EN_DEFINITION_PURPOSE.Setup
+				? { definition_purpose: EN_DEFINITION_PURPOSE.Setup }
+				: {}),
+		});
+		return $ModelDefiner.customize(assembled.def).invoke();
+	}
+}
